# Ghostty config — "Catppuccin Midnight" (matches the T3 Code theme)
# Previous config backed up to: config.backup-2026-11-15

# Fonts
font-family = "JetBrains Mono"
font-size = 14
font-thicken = true
# A little extra line spacing for readability
adjust-cell-height = 12%

# Colors — theme file: ~/.config/ghostty/themes/catppuccin-midnight
theme = catppuccin-midnight
# Keep text readable even if a program picks low-contrast colors
minimum-contrast = 3

# Window
window-theme = ghostty
macos-titlebar-style = tabs
window-padding-x = 0
window-padding-y = 0
window-padding-balance = false
# Extend edge colors into the padding so full-screen apps have no seams
window-padding-color = extend
# Reopen windows, tabs and splits after restart
window-save-state = always
# Opaque background reads best; set e.g. 0.95 to bring the blur back
background-opacity = 1
background-blur-radius = 15

# Splits
unfocused-split-opacity = 0.85

# Cursor
cursor-style-blink = false
cursor-style = block
shell-integration-features = "no-cursor"

# Input & clipboard
mouse-hide-while-typing = true
# Left Option acts as Alt (word jumps etc.); right Option still types special chars
macos-option-as-alt = left
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true

# Quick terminal (Cmd+`) — autohide on focus loss is already the macOS default
quick-terminal-animation-duration = 0.12

# macOS
macos-icon = xray

keybind = global:cmd+backquote=toggle_quick_terminal
