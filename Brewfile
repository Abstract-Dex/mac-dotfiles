# Everything this setup needs on a fresh Mac.
#   brew bundle --file=~/DotConfig/Brewfile          # install
#   brew bundle check --file=~/DotConfig/Brewfile    # what's missing?

tap "nikitabobko/tap"

# --- needed by the dotfiles --------------------------------------------------
brew "stow"        # symlinks the packages in this repo into $HOME
brew "git"
brew "neovim"
brew "tmux"
brew "fzf"         # used in .zshrc
brew "zoxide"      # used in .zshrc
brew "fastfetch"
brew "ripgrep"     # LazyVim search
brew "fd"          # LazyVim file finder
brew "node"        # LazyVim / Mason language servers

cask "nikitabobko/tap/aerospace"
cask "ghostty"
cask "zed"
cask "font-meslo-lg-nerd-font"   # Powerlevel10k icons
cask "font-jetbrains-mono"       # Zed buffer font (Ghostty bundles its own copy)

# --- everyday CLI tools ------------------------------------------------------
brew "asitop"
brew "codex"
brew "ffmpeg"
brew "gh"
brew "graphviz"
brew "htop"
brew "hugo"
brew "iproute2mac"
brew "poppler"
brew "protobuf"
brew "tailscale"
brew "tealdeer"
brew "uv"

# --- apps --------------------------------------------------------------------
cask "bitwarden"
cask "claude"
cask "cursor"
cask "discord"
cask "google-chrome"
cask "ngrok"
cask "obsidian"
cask "raycast"
cask "spotify"
cask "visual-studio-code"
cask "zen"
